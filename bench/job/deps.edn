{:paths ["src" "resources" "classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        datalevin/datalevin {:mvn/version "1.1.0"}
        ;; Clojure sources only; build.clj compiles the client's Java sources.
        xyz.triplox/triplox {:local/root "../../triplox-jvm"}}
 :aliases
 {:test {:extra-paths ["test"] :main-opts ["-m" "job.test-runner"]}
  :integration-test {:extra-paths ["test"] :main-opts ["-m" "job.integration-test"]}
  :datalevin
  {:jvm-opts ["--add-opens=java.base/java.lang=ALL-UNNAMED"
              "--add-opens=java.base/java.nio=ALL-UNNAMED"
              "--add-opens=java.base/java.util=ALL-UNNAMED"
              "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"]}
  :dev {:extra-paths ["dev" "test"]
        :extra-deps {io.github.clojure/tools.build {:git/tag "v0.10.6" :git/sha "52cf7d6"}
                     nrepl/nrepl {:mvn/version "1.3.1"}
                     cider/cider-nrepl {:mvn/version "0.52.1"}}
        :main-opts ["-m" "nrepl.cmdline" "--port" "7888"
                    "--middleware" "[cider.nrepl/cider-middleware]"]}
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.6" :git/sha "52cf7d6"}}
          :ns-default build}}}
