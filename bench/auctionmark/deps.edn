{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/tools.cli {:mvn/version "1.4.256"}

        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.4.5"}

        com.google.guava/guava {:mvn/version "33.6.0-jre"}

        xyz.triplox/triplox {:mvn/version "0.1.0-incremental-auctionmark-SNAPSHOT"}}
 :aliases {:run {:main-opts ["-m" "auctionmark.main"]}

           ;; Tests run against a Triplox dev node (per-connection ephemeral
           ;; in-memory database). Start one first, e.g.:
           ;;   cargo run -- config/triplox-dev.toml
           ;; then: clojure -X:test
           ;; Host/port overridable via -Dtriplox.host / -Dtriplox.port.
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}}

 :mvn/repos {"clojars" {:url "https://repo.clojars.org/"
                        :snapshots {:update :always}}}}
