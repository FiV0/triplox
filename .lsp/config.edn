;; Editors open the repo root, which has no deps.edn, so list every Clojure subproject here.
{:source-paths ["triplox-jvm/src/main/clojure"
                "triplox-jvm/src/test/clojure"
                "triplox-jvm/dev"
                "bench/job/src"
                "bench/job/test"
                "bench/graph/src"
                "bench/auctionmark/src"
                "bench/auctionmark/test"
                "examples/clj/src"
                "examples/clj/notebooks"
                "examples/clojure/src"]
 ;; clojure-lsp merges the classpaths of all specs whose project-path exists.
 ;; Published Triplox jars are dropped so xyz.triplox resolves to triplox-jvm only.
 :project-specs [{:project-path "triplox-jvm/deps.edn"
                  :classpath-cmd ["sh" "-c" "cd triplox-jvm && clojure -Spath"]}
                 {:project-path "bench/job/deps.edn"
                  :classpath-cmd ["sh" "-c" "cd bench/job && clojure -Spath -A:dev"]}
                 {:project-path "bench/graph/deps.edn"
                  :classpath-cmd ["sh" "-c" "cd bench/graph && clojure -Spath | tr : '\\n' | grep -v /xyz/triplox/triplox/ | paste -sd:"]}
                 {:project-path "bench/auctionmark/deps.edn"
                  :classpath-cmd ["sh" "-c" "cd bench/auctionmark && clojure -Spath -A:test | tr : '\\n' | grep -v /xyz/triplox/triplox/ | paste -sd:"]}
                 {:project-path "examples/clj/deps.edn"
                  :classpath-cmd ["sh" "-c" "cd examples/clj && clojure -Spath | tr : '\\n' | grep -v /xyz/triplox/triplox/ | paste -sd:"]}
                 {:project-path "examples/clojure/deps.edn"
                  :classpath-cmd ["sh" "-c" "cd examples/clojure && clojure -Spath | tr : '\\n' | grep -v /xyz/triplox/triplox/ | paste -sd:"]}]}
