{:paths ["src" "notebooks"]

 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        xyz.triplox/triplox {:mvn/version "0.1.0-alpha.8"}
        io.github.nextjournal/clerk {:mvn/version "0.18.1158"}}

 :aliases
 {:nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                       cider/cider-nrepl {:mvn/version "0.52.1"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"]}

  :run {:main-opts ["-m" "stock-demo"]}}}
