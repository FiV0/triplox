---
import type { StarlightRouteData } from '@astrojs/starlight/route-data'

interface Props {
  sublist: StarlightRouteData['sidebar']
  nested?: boolean
}

const { sublist, nested } = Astro.props

function hasCurrent(entries: StarlightRouteData['sidebar']): boolean {
  return entries.some((entry) =>
    entry.type === 'link' ? entry.isCurrent : hasCurrent(entry.entries),
  )
}
---

{
  sublist.map((entry) =>
    entry.type === 'link' ? (
      <a
        href={entry.href}
        aria-current={entry.isCurrent && 'page'}
        class:list={['entry-link', entry.attrs.class]}
        {...entry.attrs}
      >
        {entry.label}
        {entry.badge && <span class="entry-badge">{entry.badge.text}</span>}
      </a>
    ) : (
      <details
        class="container-sidebar-entry"
        open={hasCurrent(entry.entries) || !entry.collapsed}
      >
        <summary class="entry-title">
          <span>{entry.label}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="caret"
            aria-hidden="true"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </summary>
        <div class="container-group-link">
          <Astro.self sublist={entry.entries} nested />
        </div>
      </details>
    ),
  )
}

<style>
  .container-sidebar-entry {
    gap: 0.25rem;
    display: flex;
    flex-direction: column;
  }

  summary.entry-title {
    cursor: pointer;
    user-select: none;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.25rem;
    padding: 0.25rem 0.5rem;
    border-radius: calc(var(--radius) - 2px);
  }

  summary.entry-title::-webkit-details-marker {
    display: none;
  }

  summary.entry-title::marker {
    content: '';
  }

  .caret {
    transition: transform 0.2s ease-in-out;
    flex-shrink: 0;
  }

  details[open] > summary .caret {
    transform: rotate(90deg);
  }

  .container-group-link {
    font-size: 0.875rem;
    line-height: 1.25rem;
    gap: 0.125rem;
    grid-auto-rows: max-content;
    grid-auto-flow: row;
    display: grid;
  }

  .entry-link {
    text-underline-offset: 2px;
    color: var(--accent-foreground);
    font-weight: 500;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    border-radius: var(--radius);
    align-items: center;
    width: 100%;
    height: 2rem;
    display: flex;
    color: inherit;
    text-decoration: inherit;
  }

  .entry-link[aria-current='page'] {
    background-color: var(--accent);
  }

  .entry-link:hover {
    color: var(--accent-foreground);
    background-color: var(--accent);
  }

  .entry-badge {
    color: rgb(0 0 0);
    line-height: 1;
    font-size: 0.75rem;
    padding: 0.125rem 0.375rem;
    background-color: rgb(173 250 29);
    border-radius: calc(var(--radius) - 2px);
    margin-left: 0.5rem;
  }
</style>
