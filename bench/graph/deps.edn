{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/tools.cli {:mvn/version "1.4.256"}
        org.clojure/math.combinatorics {:mvn/version "0.3.2"}

        xyz.triplox/triplox {:mvn/version "0.1.0-SNAPSHOT"}

        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.4.5"}}


 :aliases {:run {:main-opts ["-m" "graph.main"]}

           #_#_:nrepl
           {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
            :main-opts ["-m" "nrepl.cmdline"]}

           :nrepl
           {:extra-deps {cider/cider-nrepl {:mvn/version "0.59.0"}}
            :main-opts ["-m" "nrepl.cmdline"
                        "--middleware" "[cider.nrepl/cider-middleware]"]}}}
