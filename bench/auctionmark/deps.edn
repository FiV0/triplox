{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/tools.cli {:mvn/version "1.4.256"}

        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.4.5"}

        com.google.guava/guava {:mvn/version "33.6.0-jre"}

        xyz.triplox/triplox {:mvn/version "0.1.0-alpha.5"}}
